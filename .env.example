# Copie para .env.local (nunca commitar .env.local — já está no .gitignore).
# Chave pública do Web3Forms (web3forms.com) usada pelos dois formulários
# (contato na home e candidatura em /fale-conosco/). Sem essa chave, os
# formulários mostram "Não foi possível enviar agora" ao tentar enviar.
NEXT_PUBLIC_WEB3FORMS_KEY=
